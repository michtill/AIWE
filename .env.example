# Copy to .env. Set a unique name, URLs, ports and volume set for each website.
AIWE_INSTANCE=aiwe
AIWE_BIND_ADDRESS=127.0.0.1
AIWE_STUDIO_PORT=8080
AIWE_PREVIEW_PORT=8081
AIWE_PRODUCTION_PORT=8082
AIWE_ORIGIN=http://127.0.0.1:8080
AIWE_PREVIEW_URL=http://127.0.0.1:8081/
AIWE_UI_LANGUAGE=en
# Set these when enabling the optional publish profile:
AIWE_PUBLISH_URL=
AIWE_PUBLISH_TOKEN=
AIWE_PRODUCTION_URL=http://production/
# Keys can also be entered in the authenticated Settings dialog.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
